{
  "name": "@mosaicxr-ai/connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connects a local Unity Editor running Mosaic Bridge to a Mosaic Cloud service, over an outbound connection only",
  "bin": {
    "mosaic-connector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "binaries": "pkg dist/index.js --targets node20-macos-arm64,node20-macos-x64,node20-win-x64,node20-linux-x64 --out-path build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "@yao-pkg/pkg": "^6.14.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "outputPath": "build"
  }
}
